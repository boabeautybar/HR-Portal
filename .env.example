# ----------------------------------------------------------------------------
# Local env template for `netlify dev`.
#
# Copy this file to `.env` (which is gitignored) and fill in the real value:
#     cp .env.example .env
#
# Then run `netlify dev` from the repo root — the Maps proxy
# (netlify/functions/maps.js) reads GOOGLE_MAPS_API_KEY from here.
#
# In production this key is NOT taken from any file: set it in
# Netlify → Site configuration → Environment variables → GOOGLE_MAPS_API_KEY,
# then redeploy. Never commit the real key.
# ----------------------------------------------------------------------------

# Google Cloud API key with these APIs enabled: Distance Matrix API,
# Places API, Directions API. Application restrictions: None (server-side secret).
GOOGLE_MAPS_API_KEY=
